{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "site/data.json",
      "site/data.js",
      "site/uptime.json",
      "site/matchmaker.json",
      "site/benchmarks.json",
      "site/tailwind.min.css",
      "site/tools/**",
      "site/sitemap.xml",
      "site/robots.txt",
      "site/badge.svg",
      "site/favicon.svg",
      "site/favicon.ico"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      },
      "complexity": {
        "noForEach": "off"
      }
    }
  }
}
