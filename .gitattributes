# DevShelf Git Attributes
# Force LF line endings across all platforms to prevent CRLF formatting traps
* text=auto eol=lf

# Explicit text files
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
